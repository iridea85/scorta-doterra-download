

  // Barra inferiore persistente anche dentro il pannello Strumenti.
  // Non dipende dalla barra Flutter sottostante: viene montata direttamente
  // nel pannello e resta visibile mentre si navigano Home/Catalogo/Spesa/etc.
  (() => {
    const NAV_ID = 'scpPersistentBottomNav';
    const STYLE_ID = 'scpPersistentBottomNavStyle';
    const EXTERNAL_TOOLS_ID = 'scortaToolsBottomV13';

    const injectPersistentNavStyle = () => {
      if (document.getElementById(STYLE_ID)) return;
      const style = document.createElement('style');
      style.id = STYLE_ID;
      style.textContent = `
        #scortaPlusPanel .scp-body{
          padding-bottom:calc(118px + env(safe-area-inset-bottom))!important;
        }
        #${NAV_ID}{
          position:absolute;
          left:0;
          right:0;
          bottom:0;
          z-index:2147483646;
          height:calc(92px + env(safe-area-inset-bottom));
          padding:8px 0 env(safe-area-inset-bottom);
          display:grid;
          grid-template-columns:repeat(3,1fr);
          align-items:stretch;
          background:#f8eef7;
          border-top:1px solid #eee1ee;
          box-shadow:0 -3px 14px rgba(67,48,73,.05);
        }
        #${NAV_ID} button{
          border:0;
          background:transparent;
          color:#4e4651;
          display:flex;
          flex-direction:column;
          align-items:center;
          justify-content:center;
          gap:5px;
          min-width:0;
          font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
          -webkit-tap-highlight-color:transparent;
        }
        #${NAV_ID} .scp-pnav-ico{
          width:54px;
          height:34px;
          border-radius:18px;
          display:grid;
          place-items:center;
          font-size:22px;
          line-height:1;
          color:#6e5578;
        }
        #${NAV_ID} .scp-pnav-label{
          font-size:13px;
          line-height:1;
          font-weight:500;
        }
        #${NAV_ID} button[data-pnav="tools"] .scp-pnav-ico{
          background:#efd8f3;
        }
        #${NAV_ID} button:active{background:#f1e5ef}
      `;
      document.head.appendChild(style);
    };

    const mountPersistentNav = () => {
      const panel = document.getElementById('scortaPlusPanel');
      const externalTools = document.getElementById(EXTERNAL_TOOLS_ID);
      if (!panel) {
        if (externalTools) externalTools.style.removeProperty('display');
        return;
      }

      injectPersistentNavStyle();
      if (externalTools) externalTools.style.setProperty('display','none','important');
      if (panel.querySelector(`#${NAV_ID}`)) return;

      const nav = document.createElement('nav');
      nav.id = NAV_ID;
      nav.setAttribute('aria-label','Navigazione principale');
      nav.innerHTML = `
        <button type="button" data-pnav="inventory" aria-label="Inventario">
          <span class="scp-pnav-ico">▣</span><span class="scp-pnav-label">Inventario</span>
        </button>
        <button type="button" data-pnav="tools" aria-label="Strumenti">
          <span class="scp-pnav-ico">⚙</span><span class="scp-pnav-label">Strumenti</span>
        </button>
        <button type="button" data-pnav="shopping" aria-label="Spesa">
          <span class="scp-pnav-ico">⌑</span><span class="scp-pnav-label">Spesa</span>
        </button>
      `;
      panel.appendChild(nav);

      nav.querySelector('[data-pnav="inventory"]').addEventListener('click', () => {
        document.getElementById('scpClose')?.click();
      });
      nav.querySelector('[data-pnav="tools"]').addEventListener('click', () => {
        panel.querySelector('[data-tab="home"]')?.click();
      });
      nav.querySelector('[data-pnav="shopping"]').addEventListener('click', () => {
        panel.querySelector('[data-tab="shopping"]')?.click();
      });
    };

    const persistentNavObserver = new MutationObserver(mountPersistentNav);
    persistentNavObserver.observe(document.documentElement,{childList:true,subtree:true});
    if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',mountPersistentNav,{once:true});
    else mountPersistentNav();
    setTimeout(mountPersistentNav,300);
    setTimeout(mountPersistentNav,1000);
  })();
