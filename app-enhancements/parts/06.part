(() => {
  'use strict';

  const INVENTORY_SUFFIX = 'doterra_inventory_v2';
  const STYLE_ID = 'scortaStockNumberV5Style';
  let migrated = false;
  let scheduled = false;
  let observer = null;

  const asInt = (value, min = 0) => Math.max(min, Math.floor(Number(value) || 0));

  const decodeRaw = (raw) => {
    if (raw == null || raw === '') return { data: [], wrapped: true };
    try {
      const first = JSON.parse(raw);
      if (Array.isArray(first)) return { data: first, wrapped: false };
      if (typeof first === 'string') {
        const second = JSON.parse(first);
        if (Array.isArray(second)) return { data: second, wrapped: true };
      }
    } catch (_) {}
    return { data: [], wrapped: true };
  };

  const encodeLike = (raw, data) => {
    const json = JSON.stringify(data);
    return decodeRaw(raw).wrapped ? JSON.stringify(json) : json;
  };

  const inventoryKeys = () => {
    const keys = [];
    for (let i = 0; i < localStorage.length; i += 1) {
      const key = localStorage.key(i);
      if (key && key.endsWith(INVENTORY_SUFFIX)) keys.push(key);
    }
    return keys;
  };

  const productKey = (product) => String(product?.id || product?.name || 'unknown');

  const normalizeProduct = (product) => {
    const openedCount = product?.openedCount == null
      ? (product?.opened === true ? 1 : 0)
      : asInt(product.openedCount);
    const autoReorder = product?.autoReorder === true;
    const manualQty = asInt(product?.shoppingQuantity || 0);
    return {
      ...product,
      stock: asInt(product?.stock || 0),
      openedCount,
      opened: openedCount > 0,
      autoReorder,
      targetReserve: asInt(product?.targetReserve ?? 1, 1),
      shoppingDismissed: autoReorder
        ? product?.shoppingDismissed === true
        : (manualQty > 0 ? false : true),
    };
  };

  const migrateModelOnce = () => {
    if (migrated) return;
    migrated = true;
    for (const storageKey of inventoryKeys()) {
      const raw = localStorage.getItem(storageKey);
      const decoded = decodeRaw(raw);
      if (!Array.isArray(decoded.data)) continue;
      let changed = false;
      const updated = decoded.data.map((product) => {
        const next = normalizeProduct(product);
        if (
          product.openedCount == null ||
          product.opened !== next.opened ||
          product.autoReorder !== next.autoReorder ||
          asInt(product.targetReserve ?? 1, 1) !== next.targetReserve ||
          product.shoppingDismissed !== next.shoppingDismissed ||
          asInt(product.stock || 0) !== next.stock
        ) changed = true;
        return next;
      });
      if (changed) localStorage.setItem(storageKey, encodeLike(raw, updated));
    }
  };

  const readProduct = (key) => {
    for (const storageKey of inventoryKeys()) {
      const list = decodeRaw(localStorage.getItem(storageKey)).data;
      const found = (Array.isArray(list) ? list : []).find((p) => productKey(p) === key);
      if (found) return normalizeProduct(found);
    }
    return null;
  };

  const updateProduct = (key, updater) => {
    let result = null;
    let changed = false;
    for (const storageKey of inventoryKeys()) {
      const raw = localStorage.getItem(storageKey);
      const decoded = decodeRaw(raw);
      if (!Array.isArray(decoded.data)) continue;
      let touched = false;
      const updated = decoded.data.map((product) => {
        if (productKey(product) !== key) return product;
        touched = true;
        const next = normalizeProduct(updater(normalizeProduct(product)));
        result = next;
        return next;
      });
      if (touched) {
        localStorage.setItem(storageKey, encodeLike(raw, updated));
        changed = true;
      }
    }
    return changed ? result : null;
  };

  const removeProduct = (key) => {
    let removed = false;
    for (const storageKey of inventoryKeys()) {
      const raw = localStorage.getItem(storageKey);
      const decoded = decodeRaw(raw);
      if (!Array.isArray(decoded.data)) continue;
      const updated = decoded.data.filter((product) => productKey(product) !== key);
      if (updated.length !== decoded.data.length) {
        localStorage.setItem(storageKey, encodeLike(raw, updated));
        removed = true;
      }
    }
    return removed;
  };

  const effectiveShopping = (product) => {
    const manual = asInt(product?.shoppingQuantity || 0);
    if (manual > 0) return manual;
    if (product?.shoppingDismissed === true) return 0;
    return Math.max(0, asInt(product?.targetReserve ?? 1, 1) - asInt(product?.stock || 0));
  };

  const injectStyle = () => {
    ['scortaStockNumberV1Style','scortaStockNumberV2Style','scortaStockNumberV3Style','scortaStockNumberV4Style']
      .forEach((id) => document.getElementById(id)?.remove());
    if (document.getElementById(STYLE_ID)) return;
    const style = document.createElement('style');
    style.id = STYLE_ID;
    style.textContent = `
      #scortaPlusPanel [data-action="opened"]{display:none!important}
      #scortaPlusPanel [data-filter="below"]{display:none!important}
      .scp-stock-editor{margin:11px 0 2px;padding:12px;border:1px solid #dfd3e3;border-radius:16px;background:#faf6fb}
      .scp-stock-heading{font-size:12px;font-weight:900;color:#514956;margin-bottom:9px}
      .scp-stock-counts{display:grid;grid-template-columns:1fr 1fr;gap:8px}
      .scp-stock-box{background:#fff;border:1px solid #e1d7e4;border-radius:14px;padding:9px}
      .scp-stock-box-title{font-size:11px;font-weight:900;color:#675e6b;margin-bottom:7px;text-align:center}
      .scp-stock-control{display:grid;grid-template-columns:34px 1fr 34px;gap:6px;align-items:center}
      .scp-stock-step{width:34px;height:36px;border:1px solid #d4c7d8;border-radius:10px;background:#fff;color:#6e5578;font-size:20px;font-weight:900;line-height:1;padding:0}
      .scp-stock-input{width:100%;min-width:0;height:36px;border:1px solid #c9bbce;border-radius:10px;background:#fff;color:#332d36;text-align:center;font-size:17px;font-weight:950;outline:none;padding:3px}
      .scp-stock-input:focus,.scp-threshold-input:focus{border-color:#80658b;box-shadow:0 0 0 3px rgba(110,85,120,.10);outline:none}
      .scp-stock-input::-webkit-inner-spin-button,.scp-stock-input::-webkit-outer-spin-button,.scp-threshold-input::-webkit-inner-spin-button,.scp-threshold-input::-webkit-outer-spin-button{display:none}
      .scp-auto-wrap{margin-top:10px;border-top:1px solid #e5dce7;padding-top:10px}
      .scp-auto-toggle-row{display:flex;align-items:center;gap:10px;cursor:pointer}
      .scp-auto-toggle{width:20px;height:20px;accent-color:#6e5578;flex:0 0 auto}
      .scp-auto-copy{flex:1;min-width:0}.scp-auto-copy b{display:block;font-size:12px;color:#514956}.scp-auto-copy small{display:block;font-size:10px;color:#817884;line-height:1.35;margin-top:2px}
      .scp-threshold-row{display:flex;align-items:center;gap:7px;margin-top:9px;padding:9px;background:#fff;border:1px solid #e1d7e4;border-radius:13px}
      .scp-threshold-row[hidden]{display:none!important}.scp-threshold-label{flex:1;font-size:11px;font-weight:850;color:#665d69}
      .scp-threshold-input{width:52px;height:34px;border:1px solid #c9bbce;border-radius:10px;text-align:center;font-size:16px;font-weight:900;color:#332d36}
      .scp-threshold-step{width:32px;height:34px;border:1px solid #d4c7d8;border-radius:9px;background:#fff;color:#6e5578;font-size:18px;font-weight:900}
      .scp-auto-status{margin-top:7px;font-size:10px;line-height:1.4;color:#766d79}.scp-auto-status.active{color:#4d7048;font-weight:750}
      .scp-stock-saved{display:inline-block;margin-top:7px;font-size:10px;color:#4d7048;font-weight:800}.scp-stock-saved[hidden]{display:none!important}
      .scp-stock-editor .scp-remove-inventory{width:100%;margin-top:10px;border:1px solid #e7cfd2;background:#fff8f8;color:#934a51;border-radius:11px;padding:9px 10px;font-size:11px;font-weight:850;text-align:center;-webkit-tap-highlight-color:transparent}
      .scp-stock-editor .scp-remove-inventory:active{background:#f7eaea}
      @media(max-width:360px){.scp-stock-counts{grid-template-columns:1fr}.scp-stock-control{grid-template-columns:38px 1fr 38px}}
    `;
    document.head.appendChild(style);
  };

  const setText = (node, value) => {
    if (node && node.textContent !== value) node.textContent = value;
  };

  const updateBadges = (card, product) => {
    const badges = card.querySelector('.scp-badges');
    if (!badges) return;
    const closed = asInt(product.stock || 0);
    const opened = asInt(product.openedCount || 0);
    const shopping = effectiveShopping(product);

    let closedBadge = [...badges.querySelectorAll('.scp-badge')]
      .find((node) => /^(Scorta|Chiusi)\s/i.test(node.textContent || ''));
    if (!closedBadge) {
      closedBadge = document.createElement('span');
      closedBadge.className = 'scp-badge';
      badges.prepend(closedBadge);
    }
    setText(closedBadge, `Chiusi ${closed}`);

    let openedBadge = [...badges.querySelectorAll('.scp-badge')]
      .find((node) => /^Aperto$/i.test((node.textContent || '').trim()) || /^Aperti\s/i.test(node.textContent || ''));
    if (!openedBadge) {
      openedBadge = document.createElement('span');
      closedBadge.insertAdjacentElement('afterend', openedBadge);
    }
    openedBadge.className = opened > 0 ? 'scp-badge green' : 'scp-badge';
    setText(openedBadge, `Aperti ${opened}`);

    let shopBadge = [...badges.querySelectorAll('.scp-badge')]
      .find((node) => /^Da comprare\s/i.test(node.textContent || ''));
    if (shopping > 0) {
      if (!shopBadge) {
        shopBadge = document.createElement('span');
        shopBadge.className = 'scp-badge orange';
        badges.appendChild(shopBadge);
      }
      setText(shopBadge, `Da comprare ${shopping}`);
    } else {
      shopBadge?.remove();
    }
  };

  const decorateCard = (card) => {
    const key = card?.dataset?.product;
    if (!key) return;
    const product = readProduct(key);
    if (!product) return;

    updateBadges(card, product);
    card.querySelector('[data-action="opened"]')?.remove();

    let editor = card.querySelector('.scp-stock-editor');
    if (editor && editor.dataset.stockUi !== '5') editor.remove();
    editor = card.querySelector('.scp-stock-editor');

    if (!editor) {
      editor = document.createElement('div');
      editor.className = 'scp-stock-editor';
      editor.dataset.stockUi = '5';
      editor.innerHTML = `
        <div class="scp-stock-heading">Le mie quantità</div>
        <div class="scp-stock-counts">
          <div class="scp-stock-box">
            <div class="scp-stock-box-title">Chiusi</div>
            <div class="scp-stock-control">
              <button class="scp-stock-step" type="button" data-count-step="closed:-1">−</button>
              <input class="scp-stock-input" data-count-input="closed" type="number" min="0" step="1" inputmode="numeric" value="${asInt(product.stock || 0)}" aria-label="Confezioni chiuse">
              <button class="scp-stock-step" type="button" data-count-step="closed:1">+</button>
            </div>
          </div>
          <div class="scp-stock-box">
            <div class="scp-stock-box-title">Aperti</div>
            <div class="scp-stock-control">
              <button class="scp-stock-step" type="button" data-count-step="opened:-1">−</button>
              <input class="scp-stock-input" data-count-input="opened" type="number" min="0" step="1" inputmode="numeric" value="${asInt(product.openedCount || 0)}" aria-label="Confezioni aperte">
              <button class="scp-stock-step" type="button" data-count-step="opened:1">+</button>
            </div>
          </div>
        </div>
        <div class="scp-auto-wrap">
          <label class="scp-auto-toggle-row">
            <input class="scp-auto-toggle" type="checkbox" ${product.autoReorder === true ? 'checked' : ''}>
            <span class="scp-auto-copy"><b>Riordino automatico</b><small>Attivalo solo sui prodotti che vuoi ricomprare quando la scorta chiusa scende.</small></span>
          </label>
          <div class="scp-threshold-row" ${product.autoReorder === true ? '' : 'hidden'}>
            <span class="scp-threshold-label">Soglia minima chiusi</span>
            <button class="scp-threshold-step" type="button" data-threshold-step="-1">−</button>
            <input class="scp-threshold-input" type="number" min="1" step="1" inputmode="numeric" value="${asInt(product.targetReserve ?? 1, 1)}" aria-label="Soglia minima chiusi">
            <button class="scp-threshold-step" type="button" data-threshold-step="1">+</button>
          </div>
          <div class="scp-auto-status"></div>
        </div>
        <span class="scp-stock-saved" hidden>Salvato</span>
        <button class="scp-remove-inventory" type="button">Rimuovi dall’inventario</button>
      `;
      const row = card.querySelector('.scp-row');
      if (row) row.insertAdjacentElement('afterend', editor);
      else card.prepend(editor);
    }

    if (editor.dataset.stockWired === '1') return;
    editor.dataset.stockWired = '1';

    const closedInput = editor.querySelector('[data-count-input="closed"]');
    const openedInput = editor.querySelector('[data-count-input="opened"]');
    const autoToggle = editor.querySelector('.scp-auto-toggle');
    const thresholdRow = editor.querySelector('.scp-threshold-row');
    const thresholdInput = editor.querySelector('.scp-threshold-input');
    const status = editor.querySelector('.scp-auto-status');
    const savedNote = editor.querySelector('.scp-stock-saved');

    const showSaved = () => {
      savedNote.hidden = false;
      clearTimeout(editor._savedTimer);
      editor._savedTimer = setTimeout(() => { savedNote.hidden = true; }, 800);
    };

    const refresh = (current = readProduct(key)) => {
      if (!current) return;
      updateBadges(card, current);
      closedInput.value = String(asInt(current.stock || 0));
      openedInput.value = String(asInt(current.openedCount || 0));
      autoToggle.checked = current.autoReorder === true;
      thresholdInput.value = String(asInt(current.targetReserve ?? 1, 1));
      thresholdRow.hidden = current.autoReorder !== true;
      const threshold = asInt(current.targetReserve ?? 1, 1);
      const closed = asInt(current.stock || 0);
      if (current.autoReorder === true) {
        status.classList.add('active');
        setText(status, closed < threshold
          ? `Sotto soglia: nella Spesa vengono proposti ${threshold - closed} pezzi.`
          : `Attivo: entrerà nella Spesa quando i chiusi scendono sotto ${threshold}.`);
      } else {
        status.classList.remove('active');
        setText(status, 'Disattivato: anche arrivando a 0 non entrerà da solo nella Spesa.');
      }
    };

    const saveClosed = () => {
      const saved = updateProduct(key, (p) => ({
        ...p,
        stock: asInt(closedInput.value),
        shoppingDismissed: p.autoReorder === true ? false : (asInt(p.shoppingQuantity || 0) > 0 ? false : true),
      }));
      if (saved) { refresh(saved); showSaved(); }
    };

    const saveOpened = () => {
      const count = asInt(openedInput.value);
      const saved = updateProduct(key, (p) => ({ ...p, openedCount: count, opened: count > 0 }));
      if (saved) { refresh(saved); showSaved(); }
    };

    const saveThreshold = () => {
      const saved = updateProduct(key, (p) => ({
        ...p,
        targetReserve: asInt(thresholdInput.value, 1),
        shoppingDismissed: p.autoReorder === true ? false : p.shoppingDismissed,
      }));
      if (saved) { refresh(saved); showSaved(); }
    };

    let closedTimer = null;
    let openedTimer = null;
    let thresholdTimer = null;
    closedInput.addEventListener('input', () => { clearTimeout(closedTimer); closedTimer = setTimeout(saveClosed, 180); });
    closedInput.addEventListener('change', saveClosed);
    closedInput.addEventListener('blur', saveClosed);
    openedInput.addEventListener('input', () => { clearTimeout(openedTimer); openedTimer = setTimeout(saveOpened, 180); });
    openedInput.addEventListener('change', saveOpened);
    openedInput.addEventListener('blur', saveOpened);
    thresholdInput.addEventListener('input', () => { clearTimeout(thresholdTimer); thresholdTimer = setTimeout(saveThreshold, 180); });
    thresholdInput.addEventListener('change', saveThreshold);
    thresholdInput.addEventListener('blur', saveThreshold);

    editor.querySelectorAll('[data-count-step]').forEach((button) => button.addEventListener('click', () => {
      const [kind, rawDelta] = String(button.dataset.countStep || '').split(':');
      const input = kind === 'opened' ? openedInput : closedInput;
      input.value = String(Math.max(0, asInt(input.value) + Number(rawDelta || 0)));
      if (kind === 'opened') saveOpened(); else saveClosed();
    }));

    autoToggle.addEventListener('change', () => {
      const enabled = autoToggle.checked;
      const saved = updateProduct(key, (p) => ({
        ...p,
        autoReorder: enabled,
        shoppingDismissed: enabled ? false : (asInt(p.shoppingQuantity || 0) > 0 ? false : true),
      }));
      if (saved) { refresh(saved); showSaved(); }
    });

    editor.querySelectorAll('[data-threshold-step]').forEach((button) => button.addEventListener('click', () => {
      thresholdInput.value = String(Math.max(1, asInt(thresholdInput.value, 1) + Number(button.dataset.thresholdStep || 0)));
      saveThreshold();
    }));

    editor.querySelector('.scp-remove-inventory')?.addEventListener('click', () => {
      const current = readProduct(key);
      if (!current) return;
      const name = current.name || 'questo prodotto';
      if (!confirm(`Rimuovere ${name} dall’inventario?\n\nSe vuoi solo indicare che non ne hai più, lascia Chiusi e Aperti a 0: il prodotto resterà visibile.`)) return;
      if (!removeProduct(key)) return;
      if (typeof window.scortaPlusShow === 'function') window.scortaPlusShow('home');
      else card.remove();
    });

    refresh(product);
  };

  const decorateAll = () => {
    scheduled = false;
    const panel = document.getElementById('scortaPlusPanel');
    if (!panel) return;

    observer?.disconnect();
    try {
      migrateModelOnce();
      injectStyle();
      panel.querySelectorAll('[data-product]').forEach(decorateCard);
    } finally {
      observer?.observe(document.documentElement, { childList: true, subtree: true });
    }
  };

  const scheduleDecorate = () => {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(decorateAll);
  };

  observer = new MutationObserver(scheduleDecorate);
  observer.observe(document.documentElement, { childList: true, subtree: true });

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', scheduleDecorate, { once: true });
  else scheduleDecorate();
  setTimeout(scheduleDecorate, 300);
  setTimeout(scheduleDecorate, 1000);
})();
