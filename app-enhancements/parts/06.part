
(() => {
  'use strict';

  const INVENTORY_SUFFIX = 'doterra_inventory_v2';
  const STYLE_ID = 'scortaStockNumberV2Style';

  const decodeRaw = (raw) => {
    if (raw == null || raw === '') return { data: [], wrapped: true };
    try {
      const first = JSON.parse(raw);
      if (Array.isArray(first)) return { data: first, wrapped: false };
      if (typeof first === 'string') {
        const second = JSON.parse(first);
        if (Array.isArray(second)) return { data: second, wrapped: true };
      }
    } catch (_) {}
    return { data: [], wrapped: true };
  };

  const encodeLike = (raw, data) => {
    const wrapped = decodeRaw(raw).wrapped;
    const json = JSON.stringify(data);
    return wrapped ? JSON.stringify(json) : json;
  };

  const inventoryKeys = () => {
    const keys = [];
    for (let i = 0; i < localStorage.length; i += 1) {
      const key = localStorage.key(i);
      if (key && key.endsWith(INVENTORY_SUFFIX)) keys.push(key);
    }
    return keys;
  };

  const productKey = (product) => String(product?.id || product?.name || 'unknown');

  const readProduct = (key) => {
    for (const storageKey of inventoryKeys()) {
      const list = decodeRaw(localStorage.getItem(storageKey)).data;
      const found = (Array.isArray(list) ? list : []).find((p) => productKey(p) === key);
      if (found) return found;
    }
    return null;
  };

  const saveStock = (key, value) => {
    const next = Math.max(0, Math.floor(Number(value) || 0));
    let changed = false;

    for (const storageKey of inventoryKeys()) {
      const raw = localStorage.getItem(storageKey);
      const decoded = decodeRaw(raw);
      if (!Array.isArray(decoded.data)) continue;
      let touched = false;
      const updated = decoded.data.map((product) => {
        if (productKey(product) !== key) return product;
        touched = true;
        return { ...product, stock: next };
      });
      if (touched) {
        localStorage.setItem(storageKey, encodeLike(raw, updated));
        changed = true;
      }
    }

    return changed ? next : null;
  };

  const injectStyle = () => {
    document.getElementById('scortaStockNumberV1Style')?.remove();
    if (document.getElementById(STYLE_ID)) return;
    const style = document.createElement('style');
    style.id = STYLE_ID;
    style.textContent = `
      .scp-stock-editor{
        display:flex;align-items:center;gap:9px;margin:11px 0 2px;padding:11px 12px;
        border:1px solid #dfd3e3;border-radius:15px;background:#faf6fb
      }
      .scp-stock-editor label{flex:1;min-width:0;font-size:12px;font-weight:900;color:#514956;line-height:1.2}
      .scp-stock-editor label small{display:block;margin-top:3px;font-size:10px;font-weight:600;color:#8a818d;line-height:1.25}
      .scp-stock-step{
        width:38px;height:38px;border:1px solid #d4c7d8;border-radius:11px;background:#fff;color:#6e5578;
        font-size:21px;font-weight:900;line-height:1;padding:0
      }
      .scp-stock-input{
        width:58px;height:40px;border:1px solid #c9bbce;border-radius:11px;background:#fff;color:#332d36;
        text-align:center;font-size:18px;font-weight:950;outline:none;padding:4px
      }
      .scp-stock-input:focus{border-color:#80658b;box-shadow:0 0 0 3px rgba(110,85,120,.10)}
      .scp-stock-input::-webkit-inner-spin-button,.scp-stock-input::-webkit-outer-spin-button{display:none}
      .scp-stock-saved{display:block;margin-top:4px;font-size:10px;color:#4d7048;font-weight:800}
    `;
    document.head.appendChild(style);
  };

  const decorateCard = (card) => {
    if (!card) return;
    const key = card.dataset.product;
    if (!key) return;
    const product = readProduct(key);
    if (!product) return;

    let editor = card.querySelector('.scp-stock-editor');
    if (!editor) {
      editor = document.createElement('div');
      editor.className = 'scp-stock-editor';
      editor.innerHTML = `
        <label>Quantità nel mio inventario<small>Confezioni chiuse; l'eventuale confezione aperta è indicata a parte</small><span class="scp-stock-saved" hidden>Salvato</span></label>
        <button class="scp-stock-step" type="button" data-stock-step="-1" aria-label="Diminuisci quantità">−</button>
        <input class="scp-stock-input" type="number" min="0" step="1" inputmode="numeric" pattern="[0-9]*" value="${Math.max(0, Number(product.stock || 0))}" aria-label="Quantità nel mio inventario">
        <button class="scp-stock-step" type="button" data-stock-step="1" aria-label="Aumenta quantità">+</button>
      `;

      const row = card.querySelector('.scp-row');
      if (row) row.insertAdjacentElement('afterend', editor);
      else card.prepend(editor);
    }

    if (editor.dataset.stockWired === '1') return;
    editor.dataset.stockWired = '1';

    const input = editor.querySelector('.scp-stock-input');
    const savedNote = editor.querySelector('.scp-stock-saved');
    let lastSaved = Math.max(0, Number(product.stock || 0));
    let timer = null;

    const commit = () => {
      const normalized = Math.max(0, Math.floor(Number(input.value) || 0));
      input.value = String(normalized);
      if (normalized === lastSaved) return;
      const saved = saveStock(key, normalized);
      if (saved == null) return;
      lastSaved = saved;

      const badge = [...card.querySelectorAll('.scp-badge')]
        .find((node) => /^Scorta\s/i.test(node.textContent || ''));
      if (badge) badge.textContent = `Scorta ${saved}`;

      if (savedNote) {
        savedNote.hidden = false;
        clearTimeout(editor._savedTimer);
        editor._savedTimer = setTimeout(() => { savedNote.hidden = true; }, 900);
      }
    };

    const queueCommit = () => {
      clearTimeout(timer);
      timer = setTimeout(commit, 180);
    };

    input.addEventListener('input', queueCommit);
    input.addEventListener('change', commit);
    input.addEventListener('blur', commit);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        commit();
        input.blur();
      }
    });

    editor.querySelectorAll('[data-stock-step]').forEach((button) => {
      button.addEventListener('click', () => {
        const delta = Number(button.dataset.stockStep || 0);
        const current = Math.max(0, Math.floor(Number(input.value) || 0));
        input.value = String(Math.max(0, current + delta));
        commit();
      });
    });
  };

  const decorate = () => {
    injectStyle();
    document.querySelectorAll('#scortaPlusPanel [data-product]').forEach(decorateCard);
  };

  const observer = new MutationObserver(() => decorate());
  observer.observe(document.documentElement, { childList: true, subtree: true });

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', decorate, { once: true });
  else decorate();
})();
